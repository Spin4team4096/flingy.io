            "children": [
                {
                    "type": "text",
                    "label": "(2026.07.24 at 17:10 GMT)",
                    "opacity": 0.5,
                    "size": 15
                },
                {
                    "type": "text",
                    "label": "it's a big one"
                },
                {
                    "type": "server",
                    "children": [
                        {
                            "type": "point",
                            "label": "Bots are smarter now:",
                            "children": [
                                {
                                    "type": "point",
                                    "label": "Much less likely to release small flails"
                                },
                                {
                                    "type": "point",
                                    "label": "`Move` phase - Only chases if its flail is bigger than the enemy, otherwise just goes straight to spinning"
                                },
                                {
                                    "type": "point",
                                    "label": "Dodging is now added to `move` phase (previously only in `spin` phase)"
                                }
                            ]
                        },
                        {
                            "type": "point",
                            "label": "Added more server settings:",
                            "children": [
                                {
                                    "type": "point",
                                    "label": "`matchTime` controls how long until the border shrinks to deathmatch size"
                                },
                                {
                                    "type": "point",
                                    "label": "`botPercentage` replaced the old `spawnBots` setting, so I can spawn 0% bots, 50%, 69%, 100% etc"
                                }
                            ]
                        },
                        {
                            "type": "point",
                            "label": "Other minor tweaks/fixes"
                        }
                    ]
                },
                {
                    "type": "client",
                    "children": [
                        {
                            "type": "point",
                            "label": "Added a gamemode selector! It's similar to cobbled.io; the main difference is that it selects gamemodes but not a specific lobby"
                        },
                        {
                            "type": "point",
                            "label": "If you can't connect to a server, it marks it as dead and picks a different server next try (so if one server crashes, you can still access the others)"
                        },
                        {
                            "type": "point",
                            "label": "Bug Fixes:",
                            "children": [
                                {
                                    "type": "point",
                                    "label": "Minimap no longer shows your dot if you're dead"
                                },
                                {
                                    "type": "point",
                                    "label": "Sound volume now uses distance from camera position instead of player position"
                                },
                                {
                                    "type": "point",
                                    "label": "`Time Alive` stat now shows the total time alive from all 3 runs, not just time since last death. (It's also lag resistant now)"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "type": "section",
