                    "type": "text",
                    "label": "losta optimisation:"
                },
                {
                    "type": "server",
                    "children": [
                        {
                            "type": "point",
                            "label": "Network packets are significantly smaller now:",
                            "children": [
                                {
                                    "type": "point",
                                    "label": "Dead players are excluded from entity data entirely"
                                },
                                {
                                    "type": "point",
                                    "label": "The remaining data is encoded into binary (just like cobbled.io):",
                                    "children": [
                                        {
                                            "type": "point",
                                            "label": "1846 --> 321 bytes for 4 alive players (82.6% smaller wowie)"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "type": "point",
                            "label": "Bug Fix: Player count no longer includes bots lol"
                        }
                    ]
                },
                {
                    "type": "client",
                    "children": [
                        {
                            "type": "point",
                            "label": "Only renders up to 256 players on the minimap, after which it shows a brown underlay"
                        },
                        {
                            "type": "point",
                            "label": "Client now appends `[BOT] ` to names instead of the server"
                        },
                        {
                            "type": "point",
                            "label": "No longer does movement prediction for players outside of view"
                        },
                        {
                            "type": "point",
                            "label": "Entity view-culling now takes usernames and other text into consideration when calculating the bounding box"
                        },
                        {
                            "type": "point",
                            "label": "Only the newest 8 notifications can render at once."
                        }
                    ]
                }
