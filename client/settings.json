            {"type": "slider", "label": "Animation Time", "setting": "animationTime", "min": 0, "max": 2, "step": 0.05},
            {"type": "slider", "label": "Spin Time", "setting": "spinTime", "min": 0.25, "max": 2, "step": 0.05}
        ]},
        {"type": "section", "label": "HUD", "open": true, "color": "coral", "children": [
