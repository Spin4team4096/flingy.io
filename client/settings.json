            {"type": "text", "label": "**NOTE: Client-Side *Predict*ion has not been added yet; if selected, the game actually uses Interpolation**", "size": 15, "opacity": 0.5}
        ]},
        {"type": "section", "label": "Debug", "open": true, "color": "yellow", "children": [
