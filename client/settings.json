            {"type": "choice", "label": "Image Scaling", "setting": "imageScaling", "options": [{"label": "Pixelated", "value": "pixelated"}, {"label": "Smooth", "value": "auto"}]},
            {"type": "choice", "label": "Smooth", "setting": "smoothing", "options": [{"label": "Off", "value": "off"}, {"label": "Interpolate", "value": "interpolate"}, {"label": "Predict", "value": "predict"}]},
