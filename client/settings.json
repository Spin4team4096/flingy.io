            {"type": "choice", "label": "Show Debug (I)", "setting": "showDebugActivation", "options": [{"label": "Hold", "value": "hold"}, {"label": "Toggle", "value": "toggle"}]},
            {"type": "choice", "label": "Render Debug ()", "setting": "renderDebugActivation", "options": [{"label": "Hold", "value": "hold"}, {"label": "Toggle", "value": "toggle"}]}
